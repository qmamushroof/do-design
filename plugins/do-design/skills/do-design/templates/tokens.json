{
  "$description": "do-design tokens. FORMAT EXAMPLE ONLY — replace every value with the chosen direction. Leaves have $value; references use {group.path}; themed groups nest light/dark. Naming: color.primitive.ramp.step → --ramp-step; color.<theme>.role → --role; other groups → --group-key.",
  "color": {
    "$type": "color",
    "primitive": {
      "neutral": {
        "50": { "$value": "oklch(98.4% 0.004 250)" },
        "100": { "$value": "oklch(96.2% 0.006 250)" },
        "200": { "$value": "oklch(91.8% 0.008 250)" },
        "300": { "$value": "oklch(86.0% 0.010 250)" },
        "400": { "$value": "oklch(70.5% 0.012 250)" },
        "500": { "$value": "oklch(55.4% 0.014 250)" },
        "600": { "$value": "oklch(44.6% 0.014 250)" },
        "700": { "$value": "oklch(37.2% 0.014 250)" },
        "800": { "$value": "oklch(27.9% 0.012 250)" },
        "900": { "$value": "oklch(21.0% 0.010 250)" },
        "950": { "$value": "oklch(14.5% 0.008 250)" }
      },
      "accent": {
        "300": { "$value": "oklch(78% 0.10 250)" },
        "500": { "$value": "oklch(58% 0.16 250)" },
        "600": { "$value": "oklch(51% 0.16 250)" },
        "700": { "$value": "oklch(45% 0.15 250)" }
      },
      "red":   { "600": { "$value": "oklch(52% 0.19 27)" },  "300": { "$value": "oklch(75% 0.12 27)" } },
      "amber": { "600": { "$value": "oklch(55% 0.13 70)" },  "300": { "$value": "oklch(83% 0.12 80)" } },
      "green": { "600": { "$value": "oklch(50% 0.12 150)" }, "300": { "$value": "oklch(78% 0.12 150)" } }
    },
    "light": {
      "bg": { "$value": "{color.primitive.neutral.50}" },
      "surface": { "$value": "oklch(100% 0 0)" },
      "surface-raised": { "$value": "oklch(100% 0 0)" },
      "surface-sunken": { "$value": "{color.primitive.neutral.100}" },
      "border": { "$value": "{color.primitive.neutral.200}" },
      "border-strong": { "$value": "{color.primitive.neutral.500}" },
      "text": { "$value": "{color.primitive.neutral.950}" },
      "text-muted": { "$value": "{color.primitive.neutral.600}" },
      "text-subtle": { "$value": "oklch(51% 0.014 250)" },
      "accent": { "$value": "{color.primitive.accent.600}" },
      "accent-hover": { "$value": "{color.primitive.accent.700}" },
      "accent-fg": { "$value": "oklch(100% 0 0)" },
      "focus": { "$value": "{color.primitive.accent.500}" },
      "danger": { "$value": "{color.primitive.red.600}" },
      "danger-fg": { "$value": "oklch(100% 0 0)" },
      "warning": { "$value": "{color.primitive.amber.600}" },
      "warning-fg": { "$value": "oklch(100% 0 0)" },
      "success": { "$value": "{color.primitive.green.600}" },
      "success-fg": { "$value": "oklch(100% 0 0)" }
    },
    "dark": {
      "bg": { "$value": "{color.primitive.neutral.950}" },
      "surface": { "$value": "{color.primitive.neutral.900}" },
      "surface-raised": { "$value": "{color.primitive.neutral.800}" },
      "surface-sunken": { "$value": "oklch(12% 0.008 250)" },
      "border": { "$value": "{color.primitive.neutral.800}" },
      "border-strong": { "$value": "{color.primitive.neutral.500}" },
      "text": { "$value": "{color.primitive.neutral.50}" },
      "text-muted": { "$value": "{color.primitive.neutral.400}" },
      "text-subtle": { "$value": "{color.primitive.neutral.400}" },
      "accent": { "$value": "{color.primitive.accent.300}" },
      "accent-hover": { "$value": "oklch(84% 0.08 250)" },
      "accent-fg": { "$value": "{color.primitive.neutral.950}" },
      "focus": { "$value": "{color.primitive.accent.300}" },
      "danger": { "$value": "{color.primitive.red.300}" },
      "danger-fg": { "$value": "{color.primitive.neutral.950}" },
      "warning": { "$value": "{color.primitive.amber.300}" },
      "warning-fg": { "$value": "{color.primitive.neutral.950}" },
      "success": { "$value": "{color.primitive.green.300}" },
      "success-fg": { "$value": "{color.primitive.neutral.950}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Display Family", "Georgia", "serif"] },
    "body": { "$value": ["Body Family", "system-ui", "sans-serif"] },
    "mono": { "$value": ["Mono Family", "ui-monospace", "monospace"] }
  },
  "font-size": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" }, "sm": { "$value": "0.875rem" }, "md": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" }, "xl": { "$value": "1.375rem" }, "2xl": { "$value": "1.75rem" },
    "3xl": { "$value": "clamp(2rem, 1.5rem + 2vw, 2.75rem)" }, "4xl": { "$value": "clamp(2.5rem, 1.6rem + 4vw, 4.5rem)" }
  },
  "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "bold": { "$value": 700 } },
  "leading": { "$type": "number", "tight": { "$value": 1.1 }, "snug": { "$value": 1.3 }, "normal": { "$value": 1.55 } },
  "tracking": { "$type": "dimension", "tight": { "$value": "-0.02em" }, "normal": { "$value": "0" }, "caps": { "$value": "0.06em" } },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" }, "0-5": { "$value": "2px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" },
    "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }, "32": { "$value": "128px" }
  },
  "radius": { "$type": "dimension", "sm": { "$value": "4px" }, "md": { "$value": "6px" }, "lg": { "$value": "10px" }, "full": { "$value": "999px" } },
  "border": { "$type": "dimension", "thin": { "$value": "1px" }, "thick": { "$value": "2px" } },
  "elevation": {
    "$type": "shadow",
    "light": {
      "1": { "$value": "0 1px 2px oklch(20% 0.01 250 / 0.06), 0 1px 1px oklch(20% 0.01 250 / 0.04)" },
      "2": { "$value": "0 4px 12px -2px oklch(20% 0.01 250 / 0.10), 0 2px 4px oklch(20% 0.01 250 / 0.05)" },
      "3": { "$value": "0 16px 40px -8px oklch(20% 0.01 250 / 0.18), 0 4px 10px oklch(20% 0.01 250 / 0.06)" }
    },
    "dark": {
      "1": { "$value": "0 0 0 1px oklch(100% 0 0 / 0.06)" },
      "2": { "$value": "0 0 0 1px oklch(100% 0 0 / 0.08), 0 8px 20px oklch(0% 0 0 / 0.4)" },
      "3": { "$value": "0 0 0 1px oklch(100% 0 0 / 0.10), 0 20px 48px oklch(0% 0 0 / 0.55)" }
    }
  },
  "duration": { "$type": "duration", "fast": { "$value": "120ms" }, "base": { "$value": "180ms" }, "slow": { "$value": "280ms" } },
  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "enter": { "$value": "cubic-bezier(0, 0, 0, 1)" },
    "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "z": { "$type": "number", "dropdown": { "$value": 100 }, "sticky": { "$value": 200 }, "overlay": { "$value": 300 }, "modal": { "$value": 400 }, "toast": { "$value": 500 } },
  "breakpoint": { "$type": "dimension", "sm": { "$value": "640px" }, "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1280px" } },
  "layout": { "$type": "dimension", "content": { "$value": "1200px" }, "prose": { "$value": "70ch" }, "sidebar": { "$value": "264px" }, "gutter": { "$value": "clamp(16px, 4vw, 32px)" } },
  "$pairs": [["text", "surface-sunken"]]
}
